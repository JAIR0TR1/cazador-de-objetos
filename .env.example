# URL pública del backend desplegado en Vercel (sin barra final). No es secreta.
EXPO_PUBLIC_API_URL=https://cazador-de-objetos-api.vercel.app

# Supabase (Project Settings → API). Son públicas por diseño: la seguridad la ponen las políticas RLS.
# Nunca pongas aquí la service_role key ni la contraseña de la base de datos.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
